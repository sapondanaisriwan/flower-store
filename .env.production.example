APP_NAME="Flower Shop"
APP_ENV=production
APP_KEY=base64:xKP4LTbfR8wekg8uJFikxn4F6h69dZIhzZGbYuFZBww=
APP_DEBUG=false
APP_URL=https://sapondanai.dev

# ชื่อ Image บน Docker Hub ของคุณ
DOCKERHUB_IMAGE=adashima/flower-shop:latest

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=flower_shop
DB_USERNAME=admin
DB_PASSWORD=admin1234

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.sapondanai.dev
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@sapondanai.dev"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

